# Copy this file to .env.local and fill in the values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The address people use to reach the app (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agency to show on the sign-in page when the web address doesn't match an agency's portal domain
DEFAULT_AGENCY_SLUG=cali-ko

# Shared secrets for automated jobs. Use long random strings.
CRON_SECRET=
ZAPIER_WEBHOOK_SECRET=

# Email notifications (Resend). Leave blank to log emails instead of sending them.
RESEND_API_KEY=
NOTIFY_FROM=

# Slack app for two-way client messages (see README)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Google (Calendar now, Drive later). Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
